generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

/// Better Auth core tables

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole @default(USER)

  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  members          Member[]
  ownedOrgs        Organization[]     @relation("OrganizationOwner")
  activityLogs     ActivityLog[]
  Document         Document[]
  documentVersions DocumentVersion[]
  documentActivity DocumentActivity[]
  conversations    Conversation[]
  experiments      Experiment[]
  benchmarkRuns    BenchmarkRun[]

  apiKeys          ApiKey[]
  notifications    Notification[]
  invitationsSent  Invitation[]       @relation("InvitationInviter")
  shareLinks       ShareLink[]
  auditLogs        AuditLog[]

  ownedPrompts         Prompt[]
  promptVersions       PromptVersion[]
  ownedGoldenDatasets  GoldenDataset[]
  assignedReviews      ReviewQueue[]  @relation("ReviewAssignee")
  createdReviews       ReviewQueue[]  @relation("ReviewCreator")
  reviewedReviews      ReviewQueue[]  @relation("ReviewReviewer")
  reviewComments       ReviewComment[]

  traces               Trace[]        @relation("TraceUser")
  costRecords          CostRecord[]   @relation("CostUser")
  ownedIncidents       Incident[]     @relation("IncidentOwner")

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  token     String   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id           String  @id @default(cuid())
  accountId    String  @db.VarChar(255)
  providerId   String  @db.VarChar(64)
  userId       String
  accessToken  String? @db.Text
  refreshToken String? @db.Text
  idToken      String? @db.Text
  password     String? @db.VarChar(255)
  scope        String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

enum UserRole {
  SUPERADMIN
  ADMIN
  USER
}

/// Organization / Multi-tenant

model Organization {
  id       String  @id @default(cuid())
  name     String  @db.VarChar(255)
  slug     String  @unique @db.VarChar(128)
  logo     String?
  metadata Json?

  ownerId String
  owner   User   @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members     Member[]
  projects    Project[]
  apiKeys     ApiKey[]
  invitations Invitation[]
  shareLinks  ShareLink[]
  settings    WorkspaceSettings[]
  auditLogs   AuditLog[]

  promptFolders  PromptFolder[]
  prompts        Prompt[]
  goldenDatasets GoldenDataset[]
  reviewQueue    ReviewQueue[]
  qualityGates   QualityGate[]
  leaderboard    LeaderboardEntry[]

  traces          Trace[]
  costRecords     CostRecord[]
  driftAlerts     DriftAlert[]
  alertRules      AlertRule[]
  alertEvents     AlertEvent[]
  incidents       Incident[]
  telemetryConfig TelemetryConfig?
  providerHealth  ProviderHealth[]
  pipelineRuns    PipelineRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Member {
  id             String     @id @default(cuid())
  role           MemberRole @default(MEMBER)
  organizationId String
  userId         String
  invitedBy      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Projects

model Project {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  slug        String  @unique @db.VarChar(128)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  knowledgeBases KnowledgeBase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Knowledge Bases

model KnowledgeBase {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  documents         Document[]
  conversations     Conversation[]
  experiments       Experiment[]
  experimentRuns    ExperimentRun[]
  benchmarkDatasets BenchmarkDataset[]

  retrievalConfig Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Conversations / AI Chat

model Conversation {
  id       String  @id @default(cuid())
  title    String? @db.VarChar(255)
  model    String  @default("gpt-4o-mini")
  provider String  @default("openai")

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([userId])
  @@index([knowledgeBaseId, userId])
}

model Message {
  id      String @id @default(cuid())
  role    String @db.VarChar(16)
  content String @db.Text
  tokens  Int?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  citations MessageCitation[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model MessageCitation {
  id           String @id @default(cuid())
  chunkId      String
  documentId   String @db.VarChar(255)
  documentName String @db.VarChar(255)
  chunkIndex   Int
  pageNumber   Int?
  excerpt      String @db.Text
  similarity   Float?

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
}

/// Documents / Uploads

model Document {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(255)
  fileType        String         @db.VarChar(64)
  size            Int
  fileHash        String?        @db.VarChar(128)
  storageProvider String         @default("cloudinary")
  storageKey      String         @db.VarChar(512)
  storageUrl      String?        @db.Text
  metadata        Json?
  status          DocumentStatus @default(QUEUED)

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  chunks         DocumentChunk[]
  versions       DocumentVersion[]
  activities     DocumentActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([knowledgeBaseId, fileHash])
  @@index([uploadedById])
  @@index([status])
  @@index([knowledgeBaseId, status])
}

model DocumentChunk {
  id         String @id @default(cuid())
  content    String @db.Text
  index      Int
  metadata   Json?
  tokenCount Int?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  embedding DocumentEmbedding?

  createdAt DateTime @default(now())

  @@index([documentId, index])
}

model DocumentEmbedding {
  id         String @id @default(cuid())
  model      String @default("text-embedding-3-small")
  dimensions Int    @default(1536)
  status     String @default("pending")

  chunkId String        @unique
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

}

model DocumentVersion {
  id         String  @id @default(cuid())
  version    Int     @default(1)
  fileType   String  @db.VarChar(64)
  size       Int
  storageKey String  @db.VarChar(512)
  storageUrl String? @db.Text
  metadata   Json?
  changeNote String? @db.Text

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([documentId, version])
}

model DocumentActivity {
  id      String @id @default(cuid())
  action  String @db.VarChar(64)
  details Json?

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId, createdAt])
}

enum DocumentStatus {
  QUEUED
  UPLOADING
  STORED
  EXTRACTING
  CHUNKING
  EMBEDDING_PENDING
  EMBEDDING
  INDEXED
  READY
  ERROR
}

/// Experiment Tracking

model Experiment {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  tags        String[] @default([])
  isFavorite  Boolean @default(false)
  isArchived  Boolean @default(false)

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  datasetId String?
  dataset   BenchmarkDataset? @relation(fields: [datasetId], references: [id], onDelete: SetNull)

  embeddingModel      String  @default("text-embedding-3-small")
  retriever           String  @default("vector")
  reranker            String  @default("none")
  llm                 String  @default("gpt-4o-mini")
  promptTemplate      String  @default("default")
  chunkStrategy       String  @default("fixed")
  chunkSize           Int     @default(512)
  chunkOverlap        Int     @default(50)
  topK                Int     @default(10)
  similarityThreshold Float   @default(0.7)
  retrievalMode       String  @default("vector")

  configA Json
  configB Json?

  status String  @default("draft")
  winner String?

  runs      ExperimentRun[]
  artifacts ExperimentArtifact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([datasetId])
  @@index([status])
  @@index([knowledgeBaseId, status])
}

model ExperimentRun {
  id              String  @id @default(cuid())
  configSnapshot  Json
  query           String  @db.Text
  retrievedChunks Json
  metrics         Json?
  debug           Json?
  status          String  @default("completed")
  error           String? @db.Text

  latencyEmbedding    Float?
  latencyVectorSearch Float?
  latencyPromptBuild  Float?
  latencyLlmResponse  Float?
  totalLatency        Float?

  chunkCount Int?
  tokensUsed Int?
  cost       Float?

  embeddingModel String?
  retrievalMode  String?

  experimentId String?
  experiment   Experiment? @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@index([experimentId])
  @@index([knowledgeBaseId])
  @@index([status])
  @@index([knowledgeBaseId, createdAt])
}

model ExperimentArtifact {
  id       String  @id @default(cuid())
  type     String  @db.VarChar(64)
  name     String  @db.VarChar(255)
  mimeType String  @db.VarChar(128)
  size     Int
  data     Json?
  storageKey String? @db.VarChar(512)

  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([experimentId])
  @@index([experimentId, type])
}

/// Benchmark Datasets

model BenchmarkDataset {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  source      String? @db.VarChar(128)
  tags        String[] @default([])
  version     Int     @default(1)

  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  parentVersionId String?
  parentVersion   BenchmarkDataset? @relation("BenchmarkDatasetVersion", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   BenchmarkDataset[] @relation("BenchmarkDatasetVersion")

  questions    BenchmarkQuestion[]
  runs         BenchmarkRun[]
  experiments  Experiment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeBaseId])
  @@index([parentVersionId])
  @@index([version])
}

model BenchmarkQuestion {
  id              String  @id @default(cuid())
  question        String  @db.Text
  expectedAnswer  String? @db.Text
  expectedContext String? @db.Text
  referenceDocId  String? @db.VarChar(255)
  metadata        Json?

  datasetId String
  dataset   BenchmarkDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  results BenchmarkResult[]

  createdAt DateTime @default(now())

  @@index([datasetId])
}

model BenchmarkResult {
  id         String            @id @default(cuid())
  questionId String
  question   BenchmarkQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  retrievedChunkIds String? @db.Text
  retrievedChunks   Json?
  generatedAnswer   String? @db.Text
  promptUsed        String? @db.Text

  retrievalMetrics  Json?
  generationMetrics Json?

  latencyEmbeddingMs  Float?
  latencySearchMs     Float?
  latencyPromptMs     Float?
  latencyGenerationMs Float?
  totalLatencyMs      Float?

  configSnapshot Json?

  runId String
  run   BenchmarkRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([questionId])
}

model BenchmarkRun {
  id          String  @id @default(cuid())
  name        String? @db.VarChar(255)
  description String? @db.Text
  status      String  @default("running")

  configSnapshot Json

  aggregatedMetrics Json?

  datasetId String
  dataset   BenchmarkDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  results BenchmarkResult[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datasetId])
  @@index([createdById])
  @@index([status])
}

/// Activity / Audit Logs

model ActivityLog {
  id         String  @id @default(cuid())
  action     String  @db.VarChar(128)
  resource   String? @db.VarChar(255)
  resourceId String? @db.VarChar(255)
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, action])
}

/// Enterprise: API Keys

model ApiKey {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  keyHash     String   @unique @db.VarChar(255)
  keyPrefix   String   @db.VarChar(8)
  scopes      String[] @default(["read", "write"])
  enabled     Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([keyPrefix])
}

/// Enterprise: Invitations

model Invitation {
  id         String   @id @default(cuid())
  email      String   @db.VarChar(255)
  role       MemberRole @default(MEMBER)
  status     InvitationStatus @default(PENDING)
  token      String   @unique @db.VarChar(255)
  expiresAt  DateTime

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  acceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([email])
  @@index([token])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Enterprise: Notifications

model Notification {
  id      String @id @default(cuid())
  type    String @db.VarChar(64)
  title   String @db.VarChar(255)
  message String @db.Text
  read    Boolean @default(false)
  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Enterprise: Resource Sharing

model ShareLink {
  id         String   @id @default(cuid())
  token      String   @unique @db.VarChar(255)
  resourceType String @db.VarChar(64)
  resourceId String   @db.VarChar(255)
  permission SharePermission @default(VIEW)
  expiresAt  DateTime?
  enabled    Boolean  @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([resourceType, resourceId])
  @@index([organizationId])
}

enum SharePermission {
  VIEW
  EDIT
  ADMIN
}

/// Enterprise: Workspace Settings

model WorkspaceSettings {
  id      String @id @default(cuid())
  key     String @db.VarChar(128)
  value   Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
}

/// Enterprise: Extended Audit Log

model AuditLog {
  id         String  @id @default(cuid())
  action     String  @db.VarChar(128)
  resource   String  @db.VarChar(255)
  resourceId String? @db.VarChar(255)
  details    Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, action])
  @@index([organizationId, createdAt])
  @@index([resource, resourceId])
  @@index([createdAt])
}

/// Evaluation Platform: Prompt Management

model PromptFolder {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String?
  color       String? @db.VarChar(32)
  icon        String? @db.VarChar(32)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentId String?
  parent   PromptFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children PromptFolder[] @relation("FolderTree")

  prompts Prompt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([parentId])
}

model Prompt {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(512)
  description String? @db.Text
  tags        String[]

  status  PromptStatus @default(DRAFT)
  version Int          @default(1)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  folderId String?
  folder   PromptFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  versions       PromptVersion[]
  currentVersionId String?
  currentVersion   PromptVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([folderId])
  @@index([ownerId])
  @@index([status])
  @@index([tags])
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PromptVersion {
  id          String  @id @default(cuid())
  version     Int
  title       String  @db.VarChar(512)
  description String? @db.Text

  systemPrompt String @db.Text
  userPrompt   String @db.Text
  variables    Json?
  metadata     Json?

  model        String?  @db.VarChar(128)
  temperature  Float?
  maxTokens    Int?
  topP         Float?

  status PromptVersionStatus @default(DRAFT)

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  currentVersionOf Prompt[] @relation("CurrentVersion")

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  publishedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([promptId, version])
  @@index([promptId])
  @@index([status])
}

enum PromptVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Evaluation Platform: Golden Datasets (extends existing BenchmarkDataset)

model GoldenDataset {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  tags        String[]
  difficulty  DatasetDifficulty @default(MEDIUM)
  version     Int              @default(1)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId String?
  parent   GoldenDataset? @relation("GoldenDatasetVersion", fields: [parentId], references: [id], onDelete: SetNull)
  children GoldenDataset[] @relation("GoldenDatasetVersion")

  entries GoldenDatasetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
  @@index([difficulty])
}

enum DatasetDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model GoldenDatasetEntry {
  id          String  @id @default(cuid())
  question    String  @db.Text
  expectedAnswer   String  @db.Text
  expectedCitations String[]
  context     String? @db.Text
  tags        String[]
  category    String? @db.VarChar(128)
  metadata    Json?

  datasetId String
  dataset   GoldenDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([datasetId])
  @@index([category])
  @@index([tags])
}

/// Evaluation Platform: Human Review

model ReviewQueue {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(512)
  description String? @db.Text

  status  ReviewStatus @default(PENDING)
  priority ReviewPriority @default(NORMAL)
  score   Float?

  resourceType String  @db.VarChar(64)
  resourceId   String  @db.VarChar(255)
  metadata     Json?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("ReviewAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ReviewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  reviewerId String?
  reviewer   User?   @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  comments ReviewComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([assigneeId])
  @@index([resourceType, resourceId])
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_IMPROVEMENT
}

enum ReviewPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ReviewComment {
  id      String @id @default(cuid())
  content String @db.Text

  reviewId String
  review   ReviewQueue @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewId])
}

/// Evaluation Platform: Quality Gates

model QualityGate {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  enabled     Boolean @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  conditions Json

  results QualityGateResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model QualityGateResult {
  id      String @id @default(cuid())
  passed  Boolean
  results Json
  score   Float?

  gateId String
  gate   QualityGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  evaluationRunId String?

  createdAt DateTime @default(now())

  @@index([gateId])
  @@index([passed])
}

/// Evaluation Platform: Leaderboard

model LeaderboardEntry {
  id      String @id @default(cuid())
  entity  String  @db.VarChar(255)
  type    String  @db.VarChar(64)
  score   Float
  metrics Json
  rank    Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  period String @db.VarChar(32) @default("all")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, type, period])
  @@index([score(sort: Desc)])
}

/// Observability Platform: Traces

model Trace {
  id        String   @id @default(cuid())
  requestId String   @unique @db.VarChar(255)
  name      String   @db.VarChar(512)
  status    TraceStatus @default(OK)
  startTime DateTime
  endTime   DateTime?
  durationMs Int?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("TraceUser", fields: [userId], references: [id], onDelete: SetNull)

  provider    String?  @db.VarChar(64)
  model       String?  @db.VarChar(128)
  temperature Float?
  maxTokens   Int?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  cost         Float?

  input  String? @db.Text
  output String? @db.Text

  metadata Json?

  spans     Span[]
  events    TraceEvent[]

  createdAt DateTime @default(now())

  @@index([organizationId, startTime(sort: Desc)])
  @@index([userId, startTime(sort: Desc)])
  @@index([provider, model])
  @@index([status])
}

enum TraceStatus {
  OK
  ERROR
  TIMEOUT
  CANCELLED
}

model Span {
  id        String   @id @default(cuid())
  traceId   String
  trace     Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  parentSpanId String?
  name      String   @db.VarChar(256)
  status    SpanStatus @default(OK)
  startTime DateTime
  endTime   DateTime?
  durationMs Int?

  input  Json?
  output Json?
  attributes Json?

  createdAt DateTime @default(now())

  @@index([traceId])
  @@index([parentSpanId])
  @@index([name])
}

enum SpanStatus {
  OK
  ERROR
  UNSET
}

model TraceEvent {
  id        String   @id @default(cuid())
  traceId   String
  trace     Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(256)
  timestamp DateTime
  attributes Json?

  createdAt DateTime @default(now())

  @@index([traceId])
}

/// Observability Platform: Cost Tracking

model CostRecord {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  provider  String   @db.VarChar(64)
  model     String   @db.VarChar(128)
  operation String   @db.VarChar(64)

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  totalTokens  Int     @default(0)
  cost         Float   @default(0)
  requestCount Int     @default(0)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("CostUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([date, provider, model, operation, organizationId])
  @@index([organizationId, date])
  @@index([provider, model])
}

/// Observability Platform: Drift Detection

model DriftAlert {
  id        String   @id @default(cuid())
  type      DriftType
  severity  AlertSeverity @default(WARNING)
  status    DriftStatus @default(OPEN)
  metric    String   @db.VarChar(128)
  currentValue Float
  baselineValue Float
  deviationPercent Float
  message   String   @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([organizationId, type, status])
  @@index([createdAt(sort: Desc)])
}

enum DriftType {
  EMBEDDING_DRIFT
  PROMPT_DRIFT
  DATASET_DRIFT
  RETRIEVER_DRIFT
  MODEL_DRIFT
  LATENCY_DRIFT
  QUALITY_DRIFT
  COST_DRIFT
}

enum DriftStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

/// Observability Platform: Alert Rules

model AlertRule {
  id          String  @id @default(cuid())
  name        String  @db.VarChar(255)
  description String? @db.Text
  enabled     Boolean @default(true)

  metric      String  @db.VarChar(128)
  operator    String  @db.VarChar(16)
  threshold   Float
  windowMinutes Int   @default(5)

  severity    AlertSeverity @default(WARNING)
  cooldownMinutes Int @default(30)

  notifyWebhook String?
  notifyEmail   String?
  notifySlack   String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  events AlertEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, enabled])
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model AlertEvent {
  id        String   @id @default(cuid())
  ruleId    String
  rule      AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status    AlertEventStatus @default(FIRING)
  value     Float
  message   String   @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  firedAt   DateTime
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([ruleId, firedAt(sort: Desc)])
  @@index([organizationId, status])
}

enum AlertEventStatus {
  FIRING
  RESOLVED
  ACKNOWLEDGED
}

/// Observability Platform: Incidents

model Incident {
  id          String  @id @default(cuid())
  title       String  @db.VarChar(512)
  description String? @db.Text
  severity    IncidentSeverity @default(MINOR)
  status      IncidentStatus @default(OPEN)

  rootCause     String? @db.Text
  resolution    String? @db.Text
  postmortem    String? @db.Text

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("IncidentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  events              IncidentEvent[]

  affectedRequestCount Int @default(0)
  linkedAlertIds       String[]
  linkedTraceIds       String[]

  startedAt  DateTime @default(now())
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([severity, status])
  @@index([startedAt(sort: Desc)])
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
  FATAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
  CLOSED
}

/// Observability Platform: Incident Timeline Events

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  message    String   @db.Text
  timestamp  DateTime @default(now())

  @@index([incidentId, timestamp])
}

/// Observability Platform: Provider Health

model ProviderHealth {
  id        String   @id @default(cuid())
  provider  String   @db.VarChar(64)
  model     String   @db.VarChar(128)
  date      DateTime @db.Date

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  totalRequests  Int     @default(0)
  successCount   Int     @default(0)
  errorCount     Int     @default(0)
  timeoutCount   Int     @default(0)
  avgLatencyMs   Float   @default(0)
  p50LatencyMs   Float?
  p95LatencyMs   Float?
  p99LatencyMs   Float?
  totalCost      Float   @default(0)
  totalTokens    Int     @default(0)
  lastError      String? @db.Text
  lastErrorAt    DateTime?

  createdAt DateTime @default(now())

  @@unique([provider, model, date])
  @@index([provider, date])
  @@index([date])
  @@index([organizationId, date])
}

/// Observability Platform: Pipeline Runs

model PipelineRun {
  id        String   @id @default(cuid())
  traceId   String?
  status    PipelineStatus @default(RUNNING)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  steps PipelineStep[]

  startTime DateTime
  endTime   DateTime?
  totalMs   Int?

  createdAt DateTime @default(now())

  @@index([organizationId, startTime(sort: Desc)])
  @@index([status])
}

enum PipelineStatus {
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
}

model PipelineStep {
  id        String   @id @default(cuid())
  pipelineId String
  pipeline   PipelineRun @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(128)
  type     String  @db.VarChar(64)
  status   PipelineStatus @default(RUNNING)
  order    Int

  input    Json?
  output   Json?
  error    String? @db.Text

  startTime DateTime
  endTime   DateTime?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([pipelineId])
}

/// Observability Platform: Telemetry Configuration

model TelemetryConfig {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  samplingRate   Float        @default(1.0)
  retentionDays  Int          @default(90)
  enableTraces   Boolean      @default(true)
  enableMetrics  Boolean      @default(true)
  enableLogs     Boolean      @default(true)
  maxSpansPerTrace   Int     @default(100)
  maxEventsPerTrace  Int     @default(50)
  compressOldTraces  Boolean @default(true)
  archiveAfterDays   Int     @default(30)
}


