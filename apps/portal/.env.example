# Kairos Portal — Environment Configuration

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kairos?schema=public

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------

# [Required] Secret for signing/encrypting auth cookies.
# Generate one: openssl rand -base64 32  (must be at least 32 characters)
BETTER_AUTH_SECRET=

# [Optional] Canonical base URL of the portal, used by the auth client.
# Defaults to the current origin when unset (works for local development).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# [Optional] GitHub OAuth for social login.
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default to Gemini: it is the only provider whose embedding models are 768-wide,
# which is what the pinned pgvector column stores. Switch to openai for OpenAI
# chat; embeddings still require a 768 model, so pair it with a KB retrievalConfig
# pinned to text-embedding-004.
AI_PROVIDER=gemini #(or openai)

# Embedding models are pinned to 768 dimensions, which the pgvector column and its
# HNSW index require. Only the models listed in
# `indexableEmbeddingModels()` (src/lib/retrieval/embedding-models.ts) can be
# written; ingestion rejects anything else before it calls the provider. The
# OpenAI 1536-dim models below are kept for chat/completions only.
# Use one holder at a time, depending on the AI provider you want to use. If you want to use OpenAI, fill in the OpenAI keys and leave the Gemini keys empty. If you want to use Gemini, fill in the Gemini keys and leave the OpenAI keys empty.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Not indexable (1536-dim): setting this does not change ingestion, which rejects
# non-768 models. Kept only so the resolver reports a clear error if selected.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Podcast Audio (TTS)
# -----------------------------------------------------------------------------

# [Optional] Speech provider for podcast episode and interruption audio.
# "local" needs no credentials and emits deterministic fixture speech for
# development and tests. Set the three ElevenLabs variables below to switch.
TTS_PROVIDER=local

# ElevenLabs REST API key. Only required when TTS_PROVIDER=elevenlabs.
# Create one at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# Voice IDs for the two podcast hosts (Host A / Host B). Both must be set when
# TTS_PROVIDER=elevenlabs; a missing voice is a hard config error, never a
# silent fallback to the local fixture.
ELEVENLABS_VOICE_HOST_A=
ELEVENLABS_VOICE_HOST_B=
