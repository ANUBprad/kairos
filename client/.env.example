# Client environment template. No real credentials belong in this file.
# Public browser URL of the API (staging backend, never production).
NEXT_PUBLIC_API_URL=https://api-staging.example.test
# Public browser URL used by Better Auth; usually the same as the API URL.
NEXT_PUBLIC_BETTER_AUTH_URL=https://api-staging.example.test
# Server-side only: internal Render URL used by Next.js /api rewrites.
# This value is never exposed to the browser.
BACKEND_INTERNAL_URL=http://kairos-server-staging:8081
