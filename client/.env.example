# Client environment template. No real credentials belong in this file.
# Set to staging in the staging-only blueprint. When set, the build fails closed
# if any public or rewrite target looks like production or is not staging-owned.
DEPLOYMENT_ENV=staging
# Public browser URLs of the staging backend. HTTPS and a staging marker are
# required when DEPLOYMENT_ENV=staging.
NEXT_PUBLIC_API_URL=https://api-staging.example.test
NEXT_PUBLIC_BETTER_AUTH_URL=https://api-staging.example.test
# Server-side only: internal Render URL used by Next.js /api rewrites.
# Must contain a staging marker (or equal NEXT_PUBLIC_API_URL). Never a secret.
BACKEND_INTERNAL_URL=http://kairos-server-staging:8081
