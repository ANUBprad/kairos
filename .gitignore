.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors
*.swp
*.swo
*~

# Compiled binaries
gateway/main
gateway/main.exe

# TypeScript build info
*.tsbuildinfo

# Vercel
.vercel

# Root package-lock.json is a stray local artifact; the Node project lives in
