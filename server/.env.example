# ==============================================
# Kairos Server Environment Variables
# ==============================================

# Server Configuration
PORT=8081
NODE_ENV=development
# Explicit deployment identity. Use "staging" for every non-production
# deployment. Live Razorpay keys are rejected outside "production".
DEPLOYMENT_ENV=local
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8081

# PostgreSQL Database (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Docker Compose (repo root): postgresql://postgres:postgres@localhost:5435/kairos
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/kairos

# Render: use the **External** Database URL for local dev / Prisma Studio.
# Internal URLs (host like dpg-xxxx-a only) work only inside Render, not on your PC.
# External host looks like: dpg-xxxx-a.<region>-postgres.render.com
# Append SSL if missing: ?sslmode=require
# Isolated DISPOSABLE test database used only by integration tests. Never point
# this at a shared, staging-with-real-data, or production database. Tests delete
# the synthetic rows they create and refuse to run when this is unset.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55444/kairos_stage05

# Better Auth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_32_characters_minimum
BETTER_AUTH_URL=http://localhost:8081

# Google OAuth credentials (Better Auth sign-in uses BETTER_AUTH_URL).
# GOOGLE_REDIRECT_URI below is only for the Google Drive integration route.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Local default matches the registered integration route. Deployed environments
# must set the exact callback registered with the provider. Omit to derive it
# from SERVER_URL or BETTER_AUTH_URL.
GOOGLE_REDIRECT_URI=http://localhost:8081/api/integrations/google-drive/callback

# GitHub OAuth (login/signup + private repo imports).
# GITHUB_REDIRECT_URI below is only for the private-repo integration route.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Local default matches the registered integration route. Deployed environments
# must set the exact callback registered with the provider. Omit to derive it
# from SERVER_URL or BETTER_AUTH_URL.
GITHUB_REDIRECT_URI=http://localhost:8081/api/integrations/github/callback

# Notion OAuth (Optional — for Notion source integration)
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
# Local default matches the registered integration route. Deployed environments
# must set the exact callback registered with the provider. Omit to derive it
# from SERVER_URL or BETTER_AUTH_URL.
NOTION_REDIRECT_URI=http://localhost:8081/api/integrations/notion/callback

# AI Providers
# Gemini is the default. OpenAI is kept as an explicit legacy option.
CHAT_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
# Defaults to CHAT_PROVIDER when unset.
# OCR_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# Optional: only required when any provider above is set to openai.
# OPENAI_API_KEY=sk-proj-your_openai_api_key

# Optional model overrides. Document and query embeddings always use the same
# embedding provider/model/dimensions; never mix embedding spaces in one index.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_SECONDARY_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_OCR_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_PRO_CHAT_MODEL=gpt-4o
# OPENAI_OCR_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ElevenLabs Voice Synthesis (For Debate Podcasts & Live Interruption Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Pinecone Vector Database (For RAG Semantic Search)
PINECONE_API_KEY=your_pinecone_api_key
# Use a dedicated index per embedding model. Changing providers/models requires
# a new index and re-importing sources; vectors carry embedding identity metadata.
PINECONE_INDEX=kairos
EMBEDDING_DIMENSIONS=512

# RAG retrieval & reranking
RAG_RETRIEVE_K=20
RAG_TOP_K=6
RAG_MIN_SCORE=0.20
RERANK_ENABLED=true
RERANK_MODEL=rerank-v3.5
COHERE_API_KEY=your_cohere_api_key
CITATION_FALLBACK_TOP_N=1
QUERY_EMBED_CACHE_TTL_SEC=86400

# Web Scraping & Search APIs
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
TAVILY_API_KEY=tvly-your_tavily_api_key

# Cloudinary Media Storage (PDFs & Podcast MP3 Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Required for the unsigned upload fallback only. There is no hardcoded
# preset; use a preset you own when signed credentials are unavailable.
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Memory & Embeddings (Optional)
MEM0_API_KEY=m0-your_mem0_api_key

# Inngest — local dev only (never set INNGEST_DEV=1 on Render/production)
INNGEST_DEV=1
# Production defaults to in-process jobs on the web service (no Inngest Cloud).
# To use Inngest Cloud on Render, set ALL of the following:
# INNGEST_USE_CLOUD=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# INNGEST_SERVE_ORIGIN=https://your-exact-api.onrender.com
# Then in Inngest dashboard, sync: https://your-exact-api.onrender.com/api/inngest
# SERVER_URL=https://your-exact-api.onrender.com

# Razorpay Payments & Subscriptions (Pro Tier)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Security hardening
# Dedicated secret (32+ chars) for signed single-use OAuth state.
# REQUIRED for DEPLOYMENT_ENV=staging and production; must differ from
# BETTER_AUTH_SECRET in staging.
OAUTH_STATE_SECRET=replace_with_a_random_32_character_minimum_secret
# Comma-separated trusted proxy IPs/CIDRs when deployed behind a proxy.
# Leave unset for direct exposure. Example: 127.0.0.1,10.0.0.0/8
TRUST_PROXY=
# Staging-only isolation gates (required when DEPLOYMENT_ENV=staging):
# STAGING_DATABASE_ID must appear in DATABASE_URL (host or database name).
# STAGING_RESOURCE_PREFIX must appear in Cloudinary cloud name/upload preset.
# STAGING_FORBIDDEN_ENDPOINTS is an optional comma-separated denylist.
# PRODUCTION_DATABASE_URL, if set, is rejected as an exact staging DB match.
# STAGING_DATABASE_ID=staging_06
# STAGING_RESOURCE_PREFIX=staging
# STAGING_FORBIDDEN_ENDPOINTS=https://api.example.com
# PRODUCTION_DATABASE_URL=
