    "test:integration": "tsx --test src/integration/artifact-concurrency.integration.test.ts src/integration/round3-reliability.integration.test.ts src/integration/http-security.integration.test.ts src/integration/job-recovery.integration.test.ts src/integration/payment-sandbox.integration.test.ts",
    "test:http": "tsx --test src/integration/http-security.integration.test.ts",
    "test:jobs": "tsx --test src/integration/job-recovery.integration.test.ts",
    "test:payments": "tsx --test src/integration/payment-sandbox.integration.test.ts",
